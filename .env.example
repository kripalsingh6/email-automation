# Server Port (Render automatically sets PORT)
PORT=3001

# Frontend URL (e.g. https://your-app.vercel.app or http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# For Render: https://<your-render-service-name>.onrender.com/auth/callback
GMAIL_REDIRECT_URI=http://localhost:3001/auth/callback
GMAIL_REFRESH_TOKEN=

# Team Lead / Monitoring Settings
TEAM_LEAD_EMAIL=

# Schedule configuration (Default: 8:00 PM Monday through Friday)
CHECK_CRON=0 20 * * 1-5

